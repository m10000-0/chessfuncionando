{
  "manifest_version": 3,
  "name": "Lance Certo – Revisão de partidas",
  "short_name": "Lance Certo",
  "version": "1.0.0",
  "description": "Revise suas partidas terminadas no chess.com quantas vezes quiser, com o Stockfish rodando no seu próprio navegador.",
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": { "default_title": "Revisão Lance Certo", "default_icon": { "16": "icons/icon16.png", "48": "icons/icon48.png" } },
  "background": { "service_worker": "background.js" },
  "permissions": ["storage", "tabs"],
  "host_permissions": ["https://api.chess.com/*"],
  "content_scripts": [
    {
      "matches": ["https://www.chess.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    { "resources": ["review.html", "prank.js", "prank.html"], "matches": ["https://www.chess.com/*"] }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
